{
  "expo": {
    "name": "Agri-Vision",
    "slug": "agri-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/agri-vision-icon.png",
    "scheme": "agri-vision",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/agri-vision-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/agri-vision-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Agri-Vision to use your camera for plant diagnosis.",
          "photosPermission": "Allow Agri-Vision to access your photos for plant diagnosis.",
          "microphonePermission": false
        }
      ],
      "react-native-fast-tflite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
